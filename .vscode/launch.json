{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) tunnelpp-server",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/clang/Debug/tunnelpp-server",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "environment": [
        {
          "name": "TUNNELPP_TOKEN",
          "value": "dev-token"
        },
        {
          "name": "TUNNELPP_DOMAIN",
          "value": "tunnelpp.local"
        }
      ],
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "(gdb) tunnelpp-client",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/clang/Debug/tunnelpp-client",
      "args": [
        "--server",
        "ws://127.0.0.1:8080/tunnel",
        "--token",
        "dev-token",
        "--local",
        "http://127.0.0.1:3000",
        "--subdomain",
        "demo"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ],
  "compounds": [
    {
      "name": "(gdb) server + client",
      "configurations": ["(gdb) tunnelpp-server", "(gdb) tunnelpp-client"]
    }
  ]
}
