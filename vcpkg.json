{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tunnelpp",
  "version-string": "0.1.0",
  "description": "tunnelpp exposes local HTTP services on public subdomains through a tunnel server",
  "homepage": "https://github.com/tunnelpp/tunnelpp",
  "license": "MIT",
  "dependencies": [
    "argparse",
    "catch2",
    {
      "name": "cpp-httplib",
      "default-features": false,
      "features": [
        "openssl"
      ]
    },
    "nlohmann-json",
    "openssl",
    "spdlog"
  ],
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489"
}